---
import ContactForm from '../components/ContactForm.astro';
import { AUTHOR_NAME, AUTHOR_URL, SITE_TITLE } from '../consts';
import Layout from '../layouts/BlogPost.astro';

const faqs = [
	{
		q: 'Do you only work with tech companies?',
		a: 'No, the opposite. Main-street businesses are the point: salons, repair shops, law firms, clinics, agencies. If your team runs on phones, calendars, and repetitive admin work, that is exactly where agentic systems earn their keep.',
	},
	{
		q: 'How much does this cost?',
		a: 'Scoping is free. You tell us what you are trying to automate, we tell you what an agent can and cannot do for it, and what a build would involve. You only pay if we agree there is something worth building.',
	},
	{
		q: 'Will you tell me if AI agents are the wrong tool?',
		a: 'Yes, in writing. Plenty of problems are better solved with a checklist, a calendar rule, or a part-time hire. Saying so costs us a project and saves you a bad quarter. That trade is fine with us.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ContactPage',
			name: `Contact ${SITE_TITLE}`,
			url: new URL('/contact/', Astro.site).toString(),
			description:
				'Tell us what you are trying to automate. A real person reads every message and usually replies within two business days.',
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map(({ q, a }) => ({
				'@type': 'Question',
				name: q,
				acceptedAnswer: { '@type': 'Answer', text: a },
			})),
		},
	],
};
---

<Layout
	title="Work With Us"
	description="Tell us what you're trying to automate. A real person reads every message and usually replies within two business days."
	pubDate={new Date('Jul 12 2026')}
	isArticle={false}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<style>
		.after-form {
			margin-top: var(--space-2xl);
		}
	</style>
	<p>
		Tell us where you're stuck and we'll tell you honestly whether an agent is the right tool.
		The most useful messages mention your industry, the repetitive task eating your hours, and
		the tools you already use.
	</p>

	<ContactForm />

	<h2 class="after-form">What happens next</h2>
	<p>
		The guides on this site are written by an autonomous editor, but this inbox is not. Your
		message lands directly on <a href={AUTHOR_URL}>{AUTHOR_NAME}</a>'s phone, and a reply comes by
		email, usually within one to two business days (US Eastern hours). No automated replies, no
		sales sequence, and your address never goes on a mailing list.
	</p>

	<h2>Common questions</h2>
	{
		faqs.map(({ q, a }) => (
			<>
				<h3>{q}</h3>
				<p>{a}</p>
			</>
		))
	}
</Layout>
